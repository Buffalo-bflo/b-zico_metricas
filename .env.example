# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA cole valores reais aqui neste arquivo (.env.example) nem no chat com o assistente.

# Senha única de acesso ao app (você escolhe)
APP_PASSWORD=

# Chave aleatória usada só para assinar o cookie de login — já gerada, não precisa mexer
APP_SESSION_SECRET=

# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
